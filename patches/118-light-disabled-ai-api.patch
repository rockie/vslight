@@ -0,0 +1,97 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import type * as vscode from 'vscode';
+import type { ApiProposalName } from '../../../platform/extensions/common/extensionsApiProposals.js';
+import { assertType } from '../../../base/common/types.js';
+import { Disposable, LanguageModelError } from './extHostTypes.js';
+
+export function createRegistration(): vscode.Disposable {
+	return new Disposable(() => { });
+}
+
+export const neverEvent: vscode.Event<never> = (_listener, _thisArgs, disposables) => {
+	const registration = createRegistration();
+	disposables?.push(registration);
+	return registration;
+};
+
+export const tools: readonly vscode.LanguageModelToolInformation[] = Object.freeze([]);
+
+export function selectChatModels(): Promise<vscode.LanguageModelChat[]> {
+	return Promise.resolve([]);
+}
+
+export function invokeTool(): Promise<never> {
+	return Promise.reject(LanguageModelError.NotFound('Language model tools are unavailable in this product.'));
+}
+
+export function createLanguageModelAccessInformation(): vscode.LanguageModelAccessInformation {
+	return {
+		onDidChange: neverEvent,
+		canSendRequest: () => undefined
+	};
+}
+
+export function unavailable(api: string): never {
+	throw new Error(`${api} is unavailable in this product.`);
+}
+
+export function unavailableAsync(api: string): Promise<never> {
+	return Promise.reject(new Error(`${api} is unavailable in this product.`));
+}
+
+export function createChatParticipant(id: string, handler: vscode.ChatRequestHandler, checkProposal: (proposal: ApiProposalName) => void): vscode.ChatParticipant {
+	let requestHandler = handler;
+	let disposed = false;
+	const participant: vscode.ChatParticipant = {
+		get id() { return id; },
+		get requestHandler() { return requestHandler; },
+		set requestHandler(value) {
+			assertType(typeof value === 'function', 'Invalid request handler');
+			requestHandler = value;
+		},
+		iconPath: undefined,
+		followupProvider: undefined,
+		onDidReceiveFeedback: neverEvent,
+		get onDidPerformAction() {
+			checkProposal('chatParticipantAdditions');
+			return unavailable('ChatParticipant.onDidPerformAction');
+		},
+		get onDidChangePauseState() {
+			checkProposal('chatParticipantAdditions');
+			return unavailable('ChatParticipant.onDidChangePauseState');
+		},
+		dispose() {
+			if (!disposed) {
+				disposed = true;
+				participant.followupProvider = undefined;
+			}
+		}
+	};
+	const proposedProperties: [keyof vscode.ChatParticipant, ApiProposalName][] = [
+		['helpTextPrefix', 'defaultChatParticipant'],
+		['helpTextPostfix', 'defaultChatParticipant'],
+		['additionalWelcomeMessage', 'defaultChatParticipant'],
+		['titleProvider', 'defaultChatParticipant'],
+		['summarizer', 'defaultChatParticipant'],
+		['supportIssueReporting', 'chatParticipantPrivate'],
+		['participantVariableProvider', 'chatParticipantAdditions']
+	];
+	for (const [name, proposal] of proposedProperties) {
+		Object.defineProperty(participant, name, {
+			get() {
+				checkProposal(proposal);
+				return unavailable(`ChatParticipant.${name}`);
+			},
+			set(_value: unknown) {
+				checkProposal(proposal);
+				unavailable(`ChatParticipant.${name}`);
+			},
+			enumerable: true
+		});
+	}
+	return participant;
+}
