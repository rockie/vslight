+
+import { rejects, strictEqual } from 'assert';
+import { DeferredPromise } from '../../../../common/async.js';
+import { Emitter } from '../../../../common/event.js';
+import { InMemoryStorageDatabase, IStorageItemsChangeEvent, IUpdateRequest, Storage, StorageHint } from '../../common/storage.js';
+
+class ControlledStorageDatabase extends InMemoryStorageDatabase {
+	private readonly changes = new Emitter<IStorageItemsChangeEvent>();
+	override readonly onDidChangeItemsExternal = this.changes.event;
+	readonly updateStarted = new DeferredPromise<void>();
+	readonly releaseUpdate = new DeferredPromise<void>();
+	readonly updateGates: DeferredPromise<void>[] = [];
+	blockUpdates = false;
+
+	override async getItems(): Promise<Map<string, string>> {
+		return new Map(await super.getItems());
+	}
+
+	override async updateItems(request: IUpdateRequest): Promise<void> {
+		if (this.blockUpdates) {
+			const gate = new DeferredPromise<void>();
+			this.updateGates.push(gate);
+			this.updateStarted.complete();
+			await Promise.race([gate.p, this.releaseUpdate.p]);
+		}
+		await super.updateItems(request);
+	}
+
+	fireExternal(event: IStorageItemsChangeEvent): void {
+		this.changes.fire(event);
+	}
+
+	dispose(): void {
+		this.changes.dispose();
+	}
+}
+
+suite('Storage external changes during local writes', () => {
+	test('accepts external changes after local writes finish', async () => {
+		const database = new ControlledStorageDatabase();
+		const storage = new Storage(database);
+		await storage.init();
+		let changes = 0;
+		const listener = storage.onDidChangeStorage(() => changes++);
+		try {
+			await storage.set('secret', 'v2');
+			changes = 0;
+			database.fireExternal({ changed: new Map([['secret', 'v2']]) });
+			strictEqual(changes, 0);
+			database.fireExternal({ changed: new Map([['secret', 'remote']]) });
+			strictEqual(storage.get('secret'), 'remote');
+			strictEqual(changes, 1);
+			database.fireExternal({ deleted: new Set(['secret']) });
+			strictEqual(storage.get('secret'), undefined);
+			strictEqual(changes, 2);
+			database.fireExternal({ deleted: new Set(['secret']) });
+			strictEqual(changes, 2);
+		} finally {
+			listener.dispose();
+			await storage.close();
+			database.dispose();
+		}
+	});
+
+	test('completion of one in-memory write does not release another write', async () => {
+		const database = new ControlledStorageDatabase();
+		const storage = new Storage(database, { hint: StorageHint.STORAGE_IN_MEMORY });
+		await storage.init();
+		database.blockUpdates = true;
+		const first = storage.set('first', 'local-first');
+		const second = storage.set('second', 'local-second');
+		try {
+			strictEqual(database.updateGates.length, 2);
+			await database.updateGates[0].complete();
+			await first;
+			database.fireExternal({ deleted: new Set(['second']) });
+			strictEqual(storage.get('second'), 'local-second');
+			database.fireExternal({ changed: new Map([['second', 'stale']]) });
+			strictEqual(storage.get('second'), 'local-second');
+			await database.updateGates[1].complete();
+			await second;
+			database.fireExternal({ changed: new Map([['second', 'remote']]) });
+			strictEqual(storage.get('second'), 'remote');
+		} finally {
+			await database.releaseUpdate.complete();
+			await Promise.allSettled([first, second]);
+			await storage.close();
+			database.dispose();
+		}
+	});
+
+	test('failed database write releases its external change guard', async () => {
+		const database = new ControlledStorageDatabase();
+		const storage = new Storage(database, { hint: StorageHint.STORAGE_IN_MEMORY });
+		await storage.init();
+		database.blockUpdates = true;
+		const stored = storage.set('secret', 'local');
+		const failed = rejects(stored, /write failed/);
+		try {
+			await database.updateGates[0].error(new Error('write failed'));
+			await failed;
+			database.fireExternal({ changed: new Map([['secret', 'remote']]) });
+			strictEqual(storage.get('secret'), 'remote');
+			database.fireExternal({ deleted: new Set(['secret']) });
+			strictEqual(storage.get('secret'), undefined);
+		} finally {
+			await database.releaseUpdate.complete();
+			await Promise.allSettled([stored]);
+			await storage.close();
+			database.dispose();
+		}
+	});
+
+	for (const inFlight of [false, true]) {
+		test(`external update does not resurrect a ${inFlight ? 'flushing' : 'pending'} deletion`, async () => {
+			const database = new ControlledStorageDatabase();
+			await database.updateItems({ insert: new Map([['secret', 'v2']]) });
+			const storage = new Storage(database);
+			await storage.init();
+			database.blockUpdates = true;
+			const deleted = storage.delete('secret');
+			try {
+				if (inFlight) {
+					storage.flush(0);
+					await database.updateStarted.p;
+				}
+				database.fireExternal({ changed: new Map([['secret', 'v2']]) });
+				strictEqual(storage.get('secret'), undefined);
+				await database.releaseUpdate.complete();
+				await deleted;
+				strictEqual(storage.get('secret'), undefined);
+				database.fireExternal({ changed: new Map([['secret', 'remote']]) });
+				strictEqual(storage.get('secret'), 'remote');
+			} finally {
+				await database.releaseUpdate.complete();
+				await storage.close();
+				database.dispose();
+			}
+		});
+
+		test(`external deletion does not replace a ${inFlight ? 'flushing' : 'pending'} update`, async () => {
+			const database = new ControlledStorageDatabase();
+			const storage = new Storage(database);
+			await storage.init();
+			database.blockUpdates = true;
+			const stored = storage.set('secret', 'v2');
+			try {
+				if (inFlight) {
+					storage.flush(0);
+					await database.updateStarted.p;
+				}
+				database.fireExternal({ deleted: new Set(['secret']) });
+				strictEqual(storage.get('secret'), 'v2');
+				database.fireExternal({ changed: new Map([['secret', 'v1'], ['other', 'remote']]) });
+				strictEqual(storage.get('secret'), 'v2');
+				strictEqual(storage.get('other'), 'remote');
+				await database.releaseUpdate.complete();
+				await stored;
+				database.fireExternal({ deleted: new Set(['secret']) });
+				strictEqual(storage.get('secret'), undefined);
+			} finally {
+				await database.releaseUpdate.complete();
+				await storage.close();
+				database.dispose();
+			}
+		});
+	}
+});
