+// ZenUML injects its CSS from JavaScript, so the ordinary font loader cannot see
+// this URL. Keep the existing font inside the bundle for webviews with data-only
+// font CSP, rather than attempting a request to an absolute /fonts path.
+const zenumlFontPlugin: Plugin = {
+	name: 'zenuml-font-data-url',
+	setup(build) {
+		build.onLoad({ filter: /[/\\]@zenuml[/\\]core[/\\]dist[/\\]zenuml\.esm\.mjs$/ }, async args => {
+			const fontName = 'MS%20Sans%20Serif.ttf';
+			const [contents, font] = await Promise.all([
+				readFile(args.path, 'utf8'),
+				readFile(path.join(path.dirname(args.path), 'fonts', decodeURIComponent(fontName))),
+			]);
+			return {
+				contents: contents.replaceAll(`/fonts/${fontName}`, `data:font/ttf;base64,${font.toString('base64')}`),
+				loader: 'js',
+				resolveDir: path.dirname(args.path),
+			};
+		});
+	},
+};
+
