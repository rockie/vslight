+	metadata?: Record<string, any>;
+}
+
+export interface IOutputItemDto {
+	readonly mime: string;
+	readonly data: VSBuffer;
+}
+
+export interface NotebookCellInternalMetadata {
+	/**
+	 * Used only for diffing of Notebooks.
