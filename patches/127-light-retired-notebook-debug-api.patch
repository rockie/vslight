+import { DebugConfigurationProviderTriggerKind, DebugTreeItemCollapsibleState, IDebugVisualizationTreeItem } from '../../common/debugTypes.js';
+import { CellEditType } from '../../common/notebookTypes.js';
+import * as types from '../../common/extHostTypes.js';
+import { WorkspaceEdit } from '../../common/extHostTypeConverters.js';
+import { isICellRange } from '../../../common/notebookRange.js';
+
+import { extUri } from '../../../../base/common/resources.js';
+import { Disposable } from '../../../../base/common/lifecycle.js';
+import { IBulkEditService } from '../../../../editor/browser/services/bulkEditService.js';
+import { NullLogService } from '../../../../platform/log/common/log.js';
+import { IUriIdentityService } from '../../../../platform/uriIdentity/common/uriIdentity.js';
+import { MainThreadBulkEdits, reviveWorkspaceEditDto } from '../../browser/mainThreadBulkEdits.js';
+import { IExtHostContext } from '../../../services/extensions/common/extHostCustomers.js';
+import { ExtensionHostKind } from '../../../services/extensions/common/extensionHostKind.js';
+import { SerializableObjectWithBuffers } from '../../../services/extensions/common/proxyIdentifier.js';
+
+suite('Retired Notebook and Debug API contracts', () => {
+	const acceptProposal = (_proposal: ApiProposalName) => { };
+
+	test('debug empty queries and never events', () => {
+		const debug = createDebugApi(acceptProposal);
+		assert.strictEqual(debug.activeDebugSession, undefined);
+		assert.strictEqual(debug.activeStackItem, undefined);
+		assert.deepStrictEqual(debug.breakpoints, []);
+		let calls = 0;
+		const disposables: vscode.Disposable[] = [];
+		const event = debug.onDidStartDebugSession(() => calls++, undefined, disposables);
+		assert.deepStrictEqual(disposables, [event]);
+		event.dispose();
+		event.dispose();
+		assert.strictEqual(calls, 0);
+	});
+
+	test('debug registrations never inspect providers or invoke callbacks', () => {
+		const debug = createDebugApi(acceptProposal);
+		const provider: vscode.DebugConfigurationProvider = {
+			get provideDebugConfigurations(): never { throw new Error('provider getter was read'); }
+		};
+		const factory: vscode.DebugAdapterDescriptorFactory = {
+			get createDebugAdapterDescriptor(): never { throw new Error('factory getter was read'); }
+		};
+		const tracker: vscode.DebugAdapterTrackerFactory = {
+			get createDebugAdapterTracker(): never { throw new Error('tracker getter was read'); }
+		};
+		for (const token of [debug.registerDebugConfigurationProvider('test', provider), debug.registerDebugAdapterDescriptorFactory('test', factory), debug.registerDebugAdapterTrackerFactory('test', tracker)]) {
+			token.dispose();
+			token.dispose();
+		}
+	});
+
+	test('async debug operations return promises and reject without sync throws', async () => {
+		const debug = createDebugApi(acceptProposal);
+		for (const operation of [() => debug.startDebugging(undefined, 'test'), () => debug.stopDebugging()]) {
+			const promise = operation();
+			assert.ok(promise instanceof Promise);
+			await assert.rejects(promise, /debug\..* is unavailable in this product/);
+		}
+	});
+
+	test('sync debug operations fail clearly without an adapter', () => {
+		const debug = createDebugApi(acceptProposal);
+		assert.throws(() => debug.activeDebugConsole.append('text'), /unavailable/);
+		assert.throws(() => debug.activeDebugConsole.appendLine('text'), /unavailable/);
+		assert.throws(() => debug.addBreakpoints([]), /unavailable/);
+		assert.throws(() => debug.removeBreakpoints([]), /unavailable/);
+		assert.throws(() => debug.asDebugSourceUri({ path: '/tmp/source.ts' }), /unavailable/);
+	});
+
+	test('notebook registrations ignore provider getters and runtime creation fails', () => {
+		const notebooks = createNotebooksApi(acceptProposal);
+		const provider: vscode.NotebookCellStatusBarItemProvider = {
+			get provideCellStatusBarItems(): never { throw new Error('provider getter was read'); }
+		};
+		const token = notebooks.registerNotebookCellStatusBarItemProvider('test', provider);
+		token.dispose();
+		token.dispose();
+		assert.throws(() => notebooks.createNotebookController('id', 'test', 'label'), /unavailable/);
+		assert.throws(() => notebooks.createRendererMessaging('renderer'), /unavailable/);
+	});
+
+	test('retired proposed APIs keep authorization checks and stay unavailable when authorized', () => {
+		const checks: ApiProposalName[] = [];
+		for (const authorized of [false, true]) {
+			const check = (proposal: ApiProposalName) => { checks.push(proposal); if (!authorized) { throw new Error('proposal permission required'); } };
+			const debug = createDebugApi(check);
+			const notebooks = createNotebooksApi(check);
+			const expected = authorized ? /unavailable/ : /proposal permission required/;
+			assert.throws(() => debug.registerDebugVisualizationProvider('test', { provideDebugVisualization: () => [] }), expected);
+			assert.throws(() => debug.registerDebugVisualizationTreeProvider('test', { getTreeItem: () => undefined, getChildren: () => [] }), expected);
+			assert.throws(() => notebooks.createNotebookControllerDetectionTask('test'), expected);
+			assert.throws(() => notebooks.registerKernelSourceActionProvider('test', { provideNotebookKernelSourceActions: () => [] }), expected);
+		}
+		assert.deepStrictEqual(checks, ['debugVisualization', 'debugVisualization', 'notebookKernelSource', 'notebookKernelSource', 'debugVisualization', 'debugVisualization', 'notebookKernelSource', 'notebookKernelSource']);
+	});
+
+	test('window and workspace primitives keep never-event disposal and async failure shape', async () => {
+		let calls = 0;
+		const token = neverEvent(() => calls++);
+		token.dispose();
+		createRegistration().dispose();
+		assert.strictEqual(calls, 0);
+		for (const name of ['workspace.openNotebookDocument', 'window.showNotebookDocument']) {
+			const promise = unavailableAsync(name);
+			assert.ok(promise instanceof Promise);
+			await assert.rejects(promise, /unavailable/);
+		}
+	});
+
+	test('Notebook constructors and workspace-edit serialization retain cell data', () => {
+		const cell = new types.NotebookCellData(types.NotebookCellKind.Code, 'hello', 'typescript');
+		cell.outputs = [new types.NotebookCellOutput([types.NotebookCellOutputItem.text('world')])];
+		const data = new types.NotebookData([cell]);
+		assert.strictEqual(data.cells[0], cell);
+		const edit = new types.WorkspaceEdit();
+		edit.set(URI.file('/tmp/test.ipynb'), [types.NotebookEdit.replaceCells(new types.NotebookRange(0, 1), data.cells)]);
+		const dto = WorkspaceEdit.from(edit);
+		assert.strictEqual(dto.edits.length, 1);
+		assert.ok('cellEdit' in dto.edits[0]);
+		if ('cellEdit' in dto.edits[0] && dto.edits[0].cellEdit.editType === CellEditType.Replace) {
+			assert.strictEqual(dto.edits[0].cellEdit.cells[0].source, 'hello');
+			assert.strictEqual(dto.edits[0].cellEdit.cells[0].outputs[0].items[0].valueBytes.toString(), 'world');
+		}
+	});
+
+	test('pure debug enum values and visualization DTO remain stable', () => {
+		assert.strictEqual(DebugConfigurationProviderTriggerKind.Initial, 1);
+		assert.strictEqual(DebugConfigurationProviderTriggerKind.Dynamic, 2);
+		assert.strictEqual(DebugTreeItemCollapsibleState.Expanded, 2);
+		const item: IDebugVisualizationTreeItem = { id: 1, label: 'test', collapsibleState: DebugTreeItemCollapsibleState.Expanded };
+		assert.strictEqual(IDebugVisualizationTreeItem.deserialize(IDebugVisualizationTreeItem.serialize(item)), item);
+		const executable = new types.DebugAdapterExecutable('node', ['adapter.js']);
+		assert.strictEqual(executable.command, 'node');
+		assert.deepStrictEqual(executable.args, ['adapter.js']);
+	});
+
+	test('ordinary Comments cell-range guard retains its data contract', () => {
+		assert.strictEqual(isICellRange({ start: 0, end: 2 }), true);
+		assert.strictEqual(isICellRange({ start: '0', end: 2 }), false);
+		assert.strictEqual(isICellRange(undefined), false);
+	});
+	test('Notebook bulk edits reject as promises before calling the ordinary service', async () => {
+		let applied = 0;
+		const bulkEdit: IBulkEditService = { _serviceBrand: undefined, hasPreviewHandler: () => false, setPreviewHandler: () => Disposable.None, apply: async () => { applied++; return { isApplied: true, ariaSummary: '' }; } };
+		const identity: IUriIdentityService = { _serviceBrand: undefined, extUri, asCanonicalUri: uri => uri };
+		const rpc: IExtHostContext = { remoteAuthority: null, extensionHostKind: ExtensionHostKind.LocalProcess, getProxy() { throw new Error('unexpected RPC'); }, set() { throw new Error('unexpected RPC'); }, assertRegistered() { throw new Error('unexpected RPC'); }, drain() { throw new Error('unexpected RPC'); }, dispose() { } };
+		const log = new NullLogService();
+		const main = new MainThreadBulkEdits(rpc, bulkEdit, log, identity);
+		const edit = new types.WorkspaceEdit();
+		edit.set(URI.file('/tmp/test.ipynb'), [types.NotebookEdit.replaceCells(new types.NotebookRange(0, 1), [])]);
+		const promise = main.$tryApplyWorkspaceEdit(new SerializableObjectWithBuffers(WorkspaceEdit.from(edit)));
+		assert.ok(promise instanceof Promise);
+		await assert.rejects(promise, /Notebook workspace edits are unavailable/);
+		assert.strictEqual(applied, 0);
+		main.dispose();
+		log.dispose();
+	});
+
+	test('ordinary text and file workspace edits still revive with canonical resources', () => {
+		const identity: IUriIdentityService = { _serviceBrand: undefined, extUri, asCanonicalUri: uri => uri.with({ path: uri.path.toLowerCase() }) };
+		const edit = new types.WorkspaceEdit();
+		edit.insert(URI.file('/tmp/Test.ts'), new types.Position(0, 0), 'hello');
+		edit.createFile(URI.file('/tmp/New.ts'));
+		const revived = reviveWorkspaceEditDto(WorkspaceEdit.from(edit), identity);
+		assert.strictEqual(revived.edits.length, 2);
+		assert.ok('resource' in revived.edits[0]);
+		if ('resource' in revived.edits[0]) { assert.strictEqual(revived.edits[0].resource.path, '/tmp/test.ts'); }
+		assert.ok('newResource' in revived.edits[1]);
+		if ('newResource' in revived.edits[1]) { assert.strictEqual(revived.edits[1].newResource?.path, '/tmp/new.ts'); }
+	});
+
+});
