+// Stable API data only; no service registration or feature runtime.
+
+export const enum CellEditType {
+	Replace = 1,
+	Output = 2,
+	Metadata = 3,
+	CellLanguage = 4,
+	DocumentMetadata = 5,
+	Move = 6,
+	OutputItems = 7,
+	PartialMetadata = 8,
+	PartialInternalMetadata = 9,
