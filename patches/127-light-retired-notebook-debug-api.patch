+
+import type * as vscode from 'vscode';
+import type { ApiProposalName } from '../../../platform/extensions/common/extensionsApiProposals.js';
+import { createRegistration, neverEvent, unavailable, unavailableAsync } from './extHostDisabledAi.js';
+
+export { createRegistration, neverEvent, unavailableAsync };
+
+/** Local compatibility only: provider callbacks are neither inspected nor retained. */
+export function createDebugApi(checkProposal: (proposal: ApiProposalName) => void): typeof vscode.debug {
+	return {
+		activeDebugSession: undefined,
+		activeDebugConsole: {
+			append() { unavailable('debug.activeDebugConsole.append'); },
+			appendLine() { unavailable('debug.activeDebugConsole.appendLine'); }
+		},
+		breakpoints: [],
+		activeStackItem: undefined,
+		onDidStartDebugSession: neverEvent,
+		onDidTerminateDebugSession: neverEvent,
+		onDidChangeActiveDebugSession: neverEvent,
+		onDidReceiveDebugSessionCustomEvent: neverEvent,
+		onDidChangeBreakpoints: neverEvent,
+		onDidChangeActiveStackItem: neverEvent,
+		registerDebugConfigurationProvider() { return createRegistration(); },
+		registerDebugAdapterDescriptorFactory() { return createRegistration(); },
+		registerDebugAdapterTrackerFactory() { return createRegistration(); },
+		startDebugging() { return unavailableAsync('debug.startDebugging'); },
+		stopDebugging() { return unavailableAsync('debug.stopDebugging'); },
+		addBreakpoints() { unavailable('debug.addBreakpoints'); },
+		removeBreakpoints() { unavailable('debug.removeBreakpoints'); },
+		asDebugSourceUri() { return unavailable('debug.asDebugSourceUri'); },
+		registerDebugVisualizationProvider() {
+			checkProposal('debugVisualization');
+			return unavailable('debug.registerDebugVisualizationProvider');
+		},
+		registerDebugVisualizationTreeProvider() {
+			checkProposal('debugVisualization');
+			return unavailable('debug.registerDebugVisualizationTreeProvider');
+		}
+	};
+}
+
+export function createNotebooksApi(checkProposal: (proposal: ApiProposalName) => void): typeof vscode.notebooks {
+	return {
+		createNotebookController() { return unavailable('notebooks.createNotebookController'); },
+		registerNotebookCellStatusBarItemProvider() { return createRegistration(); },
+		createRendererMessaging() { return unavailable('notebooks.createRendererMessaging'); },
+		createNotebookControllerDetectionTask() {
+			checkProposal('notebookKernelSource');
+			return unavailable('notebooks.createNotebookControllerDetectionTask');
+		},
+		registerKernelSourceActionProvider() {
+			checkProposal('notebookKernelSource');
+			return unavailable('notebooks.registerKernelSourceActionProvider');
+		}
+	};
+}
