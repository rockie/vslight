+
+		const historicalValues = new Map<string, string>([
+			['mcpserver-github-user@example.com', JSON.stringify([{ id: 'retired.server', name: 'Retired Server', allowed: true }])],
+			['github-user@example.com-mcpserver-usages', JSON.stringify([{ mcpServerId: 'retired.server', mcpServerName: 'Retired Server', scopes: ['read'], lastUsed: 1 }])],
+			['mcpserver-github-legacy-only@example.com', JSON.stringify([{ id: 'retired.server', name: 'Retired Server', allowed: true }])],
+			['github-legacy-only@example.com-mcpserver-usages', JSON.stringify([{ mcpServerId: 'retired.server', mcpServerName: 'Retired Server', scopes: ['read'], lastUsed: 1 }])],
+			['retired.server-github', 'user@example.com'],
+			['retired.server-github-read write', 'isolated-retired-session-id']
+		]);
+		for (const [key, value] of historicalValues) {
+			storageService.store(key, value, StorageScope.APPLICATION, StorageTarget.MACHINE);
+			storageService.store(key, value, StorageScope.WORKSPACE, StorageTarget.MACHINE);
+		}
+		const getSpy = sinon.spy(storageService, 'get');
+		const storeSpy = sinon.spy(storageService, 'store');
+		const removeSpy = sinon.spy(storageService, 'remove');
+		try {
+			const service = disposables.add(instantiationService.createInstance(AuthenticationQueryService));
+			authenticationService.registerAuthenticationProvider('github', createProvider({ id: 'github', label: 'GitHub' }));
+			authenticationService.addAccounts('github', [
+				{ id: 'ordinary', label: 'user@example.com' },
+				{ id: 'legacy', label: 'legacy-only@example.com' }
+			]);
+			const providerQuery = service.provider('github');
+			assert.deepStrictEqual(await providerQuery.getAccountNames(), ['user@example.com', 'legacy-only@example.com']);
+			const legacyEntities = providerQuery.account('legacy-only@example.com').entities();
+			assert.strictEqual(legacyEntities.hasAnyUsage(), false);
+			assert.deepStrictEqual(legacyEntities.getEntityCount(), { extensions: 0, total: 0 });
+
+			const accountQuery = providerQuery.account('user@example.com');
+			const extensionQuery = accountQuery.extension('ordinary.extension');
+			extensionQuery.setAccessAllowed(true, 'Ordinary Extension');
+			extensionQuery.addUsage(['read'], 'Ordinary Extension');
+			extensionQuery.setAsPreferred();
+			assert.strictEqual(extensionQuery.isPreferred(), true);
+			assert.deepStrictEqual(accountQuery.entities().getEntityCount(), { extensions: 1, total: 1 });
+			assert.deepStrictEqual(await providerQuery.getActiveEntities(), { extensions: ['ordinary.extension'] });
+
+			accountQuery.entities().removeAllAccess();
+			assert.strictEqual(extensionQuery.isAccessAllowed(), false);
+			assert.strictEqual(extensionQuery.getUsage().length, 1);
+			accountQuery.remove();
+			assert.strictEqual(extensionQuery.isAccessAllowed(), undefined);
+			assert.strictEqual(extensionQuery.getUsage().length, 0);
+
+			extensionQuery.setAccessAllowed(true, 'Ordinary Extension');
+			extensionQuery.addUsage(['read'], 'Ordinary Extension');
+			await service.clearAllData('CLEAR_ALL_AUTH_DATA');
+			assert.strictEqual(extensionQuery.isAccessAllowed(), undefined);
+			assert.strictEqual(extensionQuery.getUsage().length, 0);
+			for (const operation of [getSpy, storeSpy, removeSpy]) {
+				assert.ok(operation.called, 'ordinary storage operations must actually run');
+				assert.deepStrictEqual(operation.getCalls().filter(call => historicalValues.has(call.args[0])), []);
+			}
+		} finally {
+			getSpy.restore();
+			storeSpy.restore();
+			removeSpy.restore();
+		}
+		for (const [key, value] of historicalValues) {
+			assert.strictEqual(storageService.get(key, StorageScope.APPLICATION), value);
+			assert.strictEqual(storageService.get(key, StorageScope.WORKSPACE), value);
+		}
+	});
+});
