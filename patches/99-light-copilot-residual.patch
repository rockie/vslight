-	if (arch === 'armhf') {
-		// VS Code build uses 'armhf'; Node reports process.arch === 'arm'
-		nodeArch = 'arm';
-	} else if (arch === 'alpine') {
-		// Legacy: { platform: 'linux', arch: 'alpine' } means alpine-x64
-		nodePlatform = 'linux';
-		nodeArch = 'x64';
